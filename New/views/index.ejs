<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="main w-full min-h-screen bg-zinc-900">
      <div class="form p-10 text-white">
        <form action="/create" method="post">
          <input
            class="block px-5 bg-zinc-800 py-2 w-full rounded-md outline-none"
            type="text"
            placeholder="Title"
            name="title"
          />
          <textarea
            class="block px-5 bg-zinc-800 mt-2 resize-none py-2 w-full rounded-md outline-none"
            name="details"
            id=""
            placeholder="Write Your Notes"

          ></textarea>
          <input
            class="mt-2 bg-blue-600 p-2 rounded-md"
            type="submit"
            value="Create Task"
          />
        </form>
      </div>
      <div class="task p-10 flex gap-4 flex-wrap text-white">
        <% if(files.length >0 ){ %>
          <% files.forEach(function(val){ %>
            <div class="task min-w-72  px-3 py-4 bg-zinc-800 rounded-md">
             <h1 class="text-3xl tracking-tighter"><%= val %></h1>
             <div class="flex w-full justify-between item-center mt-3"> 
              <a class="text-blue-500 inline-block " href="/file/<%= val %>">Read More.</a>
              <a class="text-zinc-500" href="/edit/<%= val %>">edit</a>
            </div>
            
            </div>
          <% }) %>
       <% } else{ %>
        <h3 class="text-zinc-500">No Task Yet</h3>
       <% } %>
       
      </div>
    </div>
  </body>
</html>
