<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Document</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
  <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
    <div class="w-full flex justify-end">
      <a class="bg-red-500 text-sm rounded-md inline-block px-3 mb-5 py-2" href="/logout">
        Logout
      </a>
    </div>
    <div class="flex"> <div class="w-10 mr-2 h-10  rounded-md">
      <img class="w-full h-full object-cover" src="/images/upload/<%= user.profilepic%>" alt="">
    </div>
    <h3 class="text-3xl">
      <span class="font-light">Hello</span>,<%= user.name %>
    </h3></div>
   
    <h5 class="mb-5 mt-3">You can create a new post</h5>
    <form method="post" action="/post">
      <textarea class="w-1/3 p-1 block resize-none bg-transparent border-2 border-zinc-800 rounded-md" placeholder="What's in your mind ?" name="content" id=""></textarea>
      <input class="px-3 w-40 text-sm py-2 bg-blue-500 block rounded-md mt-2" type="submit" value="Create New Post" />
    </form>
    <div class="post mt-20">
      <h3 class="text-zinc-400 pb-4">Your Posts.</h3>
      <div class="postcontainer">

<% user.posts.reverse().forEach(function(post){ %>

        <div class="post w-1/3 mb-4 rounded-md p-4 border-2 border-zinc-700 bg-zinc-800">
          <h4 class="text-blue-500 mb-3"><%= user.username %></h4>
          <p class="text-sm tracking-tight">
           <%= post.content %>
          </p>
          <small class="mt-2 inline-block"><%= post.likes.length %> Likes</small>
          <div class="btns  gap-5 flex mt-1">
            <a class="text-red-400" href="/like/<%= post._id %>"> <%= post.likes.indexOf(user._id) === -1 ? "Like" : "Unlike" %>  </a>
            <a class="text-zinc-600" href="/edit/<%= post._id %>">Edit</a>
          </div>
        </div>
<% }) %>
      </div>
    </div>
  </div>
</body>

</html>