<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/style/style.css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>

  <body class="m-0">
    <div class="w-full min-h-screen bg-zinc-900 p-8 text-white">
      <div class="nav mb-10">
        <a class="text-blue-500" href="/read">Read Users</a>
      </div>
      <h1 class="text-3xl tarcking-tighter mb-3">Create User</h1>
      <form action="/create" method="post">
        <input
          class="px-5 py-2 rounded-lg bg-transparent border border-zinc-600"
          type="text"
          name="Name"
          placeholder="Name"
        />
        <input
          class="px-5 py-2 rounded-lg bg-transparent border border-zinc-600"
          type="text"
          name="Email"
          placeholder="Email"
        />
        <input
          class="px-5 py-2 rounded-lg bg-transparent border border-zinc-600"
          type="text"
          name="Image"
          placeholder="Image url"
        />
        <input
          class="px-5 py-2 bg-blue-500 rounded-lg ml-3"
          type="submit"
          value="Create User"
        />
      </form>
    </div>
  </body>
</html>
