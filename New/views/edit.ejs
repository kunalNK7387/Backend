<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="main w-full min-h-screen bg-zinc-900 p-10 text-white">
      <a class="text-blue-500 inline-block mb-10" href="/">Go Back To Home</a>
      <form action="/edit" method="post">
        <input
          class="block px-5 bg-zinc-800 py-2 w-1/4 rounded-md outline-none"
          type="text"
          placeholder="Previous Title"
          name="previous"
          value="<%= filename %>"
        />
        <input
          class="block px-5 bg-zinc-800 py-2 w-1/4 mt-2 rounded-md outline-none"
          type="text"
          placeholder="New Name"
          name="new"
        />
        <input
          class="mt-2 bg-yellow-600 p-2 rounded-md"
          type="submit"
          value="Update Name"
        />
      </form>
    </div>
  </body>
</html>
