<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>

  <body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
      <div class="w-full flex justify-end">
        <a
          class="bg-red-500 text-sm rounded-md inline-block px-3 mb-5 py-2"
          href="/logout"
        >
          Logout
        </a>
      </div>
      <h5 class="mb-5">Edit your post.</h5>
      <form method="post" action="/update/<%= post._id %>">
        <textarea
          class="w-1/3 p-1 block resize-none bg-transparent border-2 border-zinc-800 rounded-md"
          placeholder="What's in your mind ?"
          name="content"
          id=""
        >
        <%= post.content %> </textarea
        >
        <input
          class="px-3 w-40 text-sm py-2 bg-yellow-500 text-black block rounded-md mt-2"
          type="submit"
          value="Update Post."
        />
      </form>
    </div>
  </body>
</html>
