<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <h2 class="text-black text-3xl py-5 px-5">User Login</h2>
    <form class="pt-2 px-5" method="post" action="/login">
      <input
        class="px-5 py-2 text-black border-solid-black rounded-md bg-transparent border-2"
        type="text"
        placeholder="email"
        name="email"
      />
      <input
        class="px-5 py-2 text-black border-solid-black rounded-md bg-transparent border-2"
        type="password"
        placeholder="password"
        name="password"
      />

      <input
        class="px-5 bg-zinc-400 py-2 rounded-md"
        type="submit"
        value="Login"
      />
    </form>
  </body>
</html>
